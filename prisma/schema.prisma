generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================
enum Role {
  CUSTOMER
  BUSINESS
  SUPPLIER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ==========================================
// USER & AUTHENTICATION MODELS
// ==========================================
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String
  phone       String?
  role        Role      @default(CUSTOMER)

  // B2B Business & Supplier Fields
  companyName String?
  tinNumber   String?

  orders      Order[]
  addresses   Address[]
  products    Product[] // Products supplied/managed by business or supplier
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    String   // e.g., 'Dar es Salaam', 'Mbeya'
  district  String?
  street    String
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SERVICES MODEL
// ==========================================
model Service {
  id          String   @id @default(uuid())
  title       String
  category    String   // 'web', 'graphic', 'furniture', 'tech'
  provider    String
  phone       String   // Tanzanian format e.g., 255700000000
  price       String
  timeline    String
  location    String
  description String
  tag         String?  @default("Verified Service")
  status      String   @default("Online Now")
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// E-COMMERCE PRODUCTS & VARIANTS
// ==========================================
model Product {
  id                String      @id @default(uuid())
  name              String
  sku               String?     @unique
  category          String
  description       String?
  image             String?
  basePrice         Float
  wholesalePrice    Float?      // Tiered wholesale pricing for B2B users
  minWholesaleQty   Int?        @default(10)
  stockCount        Int         @default(0)
  warehouseLocation String?     @default("Main Warehouse")

  supplierId        String?
  supplier          User?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  variants          Variant[]
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Variant {
  id        String   @id @default(uuid())
  sku       String   @unique
  color     String?
  storage   String?
  price     Float
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ORDERS & CHECKOUT
// ==========================================
model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  customerName    String?
  customerPhone   String
  shippingAddress String        @default("Default Address")
  region          String        @default("Dar es Salaam")
  subtotal        Float         @default(0.0)
  shippingFee     Float         @default(0.0)
  totalAmount     Float
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String        @default("MANUAL_MOBILE") // e.g., 'M-PESA', 'AZAM-PAY', 'AIRTEL-MONEY', 'HALOPESA', 'MIXX-BY-YAS'
  transactionRef  String?

  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int      @default(1)
  unitPrice Float
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ADMIN MODEL
// ==========================================
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}