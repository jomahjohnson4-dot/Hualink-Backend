# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://postgres:user:password@localhost:5432/hualink_db?schema=public"

# Security & Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Webhook Security (AzamPay / Selcom)
WEBHOOK_SECRET=your_webhook_hmac_secret_here

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Email Notifications (SMTP)
# Gmail App Password: https://myaccount.google.com/apppasswords
# Port 465 = implicit TLS (SMTP_SECURE=true) | Port 587 = STARTTLS (SMTP_SECURE=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_google_app_password"
# Optional: overrides the sender address (defaults to SMTP_USER)
# SMTP_FROM="Hualink Support <no-reply@yourdomain.com>"
# Optional: where high-value order alerts are delivered (defaults to SMTP_USER)
# ADMIN_ALERT_EMAIL=your_email@gmail.com
# Optional: transport tuning (defaults shown)
# SMTP_CONNECTION_TIMEOUT=10000
# SMTP_GREETING_TIMEOUT=10000
# SMTP_SOCKET_TIMEOUT=20000
# SMTP_MAX_CONNECTIONS=3
# SMTP_MAX_MESSAGES=100

# Verification Codes
# The platform always issues a random 6-digit code and emails it for real —
# in development exactly like in production. Demo mode is strictly opt-in and
# has no built-in code of its own; pin one explicitly if you need it.
# ALLOW_DEMO_OTP=true
# DEMO_OTP_CODE=123456
# DEMO_PIN_CODE=1234